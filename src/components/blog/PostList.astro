---
import type { Post } from '../../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
const formatMonth = (date: Date) => date.toLocaleDateString('en-US', {
  month: 'short', year: 'numeric', timeZone: 'UTC',
});
---
<ul class="post-list">
  {posts.map(post => <li>
    <time datetime={post.data.date.toISOString().slice(0, 7)}>{formatMonth(post.data.date)}</time>
    <a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
  </li>)}
</ul>
